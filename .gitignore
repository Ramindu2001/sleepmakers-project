vendor/

# Local SQL dumps stay out of the repo, but the barcode module ships its
# installer and schema from here - git cannot re-include a file whose
# parent directory is excluded, so the directory itself is not ignored.
db/*
!db/barcode_module.sql
!db/barcode_module_install.php
!db/BARCODE_MODULE.md
!db/shop_access_migration.php
!db/shop_access_install.php
!db/shop_access_module.sql
!db/SHOP_ACCESS_MODULE.md
!db/scan_upload_migration.php
!db/scan_upload_install.php
!db/scan_upload.sql
!db/SCAN_UPLOAD_MODULE.md
!db/customer_orders_migration.php
!db/customer_orders_install.php
!db/customer_orders.sql
!db/CUSTOMER_ORDERS_MODULE.md
!db/shop_permissions_migration.php
!db/shop_permissions_install.php
!db/shop_permissions.sql
!db/SHOP_PERMISSIONS_MODULE.md
!db/unit_barcodes_migration.php
!db/unit_barcodes_install.php
!db/unit_barcodes.sql
!db/UNIT_BARCODES_MODULE.md
!db/warehouse_fulfilment_migration.php
!db/warehouse_fulfilment_install.php
!db/warehouse_fulfilment.sql
!db/WAREHOUSE_FULFILMENT_MODULE.md
/*.sql

.env
.vscode/
node_modules/
*.log

# pre-edit safety copies taken while working - git is the real history
*.bak_barcode_*

# Server secret that signs the remember-me cookies (Includes/remember_me.php).
# Created on first use; every server has its own. Never commit it.
Includes/remember_me_secret.php

# Server database credentials read by Includes/config.php. Each server has its own.
Includes/db_credentials.php

# PHPUnit (tools/get-phpunit.sh) and its cache
tools/phpunit.phar
.phpunit.cache/
